---
import { FileText } from "lucide-react";
import { siGithub } from "simple-icons";

const linkedinPath = "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM3.555 20.452h3.564V9H3.555v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C23.2.774 22.4 0 22.222 0h.003z";
---

<footer class="site-footer" id="footer" transition:name="site-footer">
  <div class="footer-grid">
    <div>
      <p class="footer-heading">Let’s build something useful.</p>
      <a class="email-link" href="mailto:dulannimsara453@gmail.com">dulannimsara453@gmail.com</a>
    </div>
    <div class="footer-links" aria-label="Social links">
      <a href="https://github.com/anjanadulan" target="_blank" rel="noreferrer me author" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
      </a>
      <a href="https://www.linkedin.com/in/anjanawijerathna/" target="_blank" rel="noreferrer me author" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkedinPath} /></svg>
      </a>
      <a href="/resume.pdf" data-astro-reload aria-label="Résumé">
        <FileText size={15} strokeWidth={1.8} aria-hidden="true" />
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>Designed and built by Anjana Wijerathna.</span>
    <span>Colombo, Sri Lanka</span>
  </div>
</footer>
